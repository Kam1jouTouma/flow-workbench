{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "工作元素 v1 公共结构",
  "$defs": {
    "port": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "TEXT",
              "FILE",
              "JSON"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "SINGLE",
            "COLLECTION"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "label",
        "types",
        "cardinality",
        "required"
      ],
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "widget": {
          "type": "string",
          "enum": [
            "text",
            "textarea",
            "select",
            "file",
            "directory"
          ]
        }
      },
      "required": [
        "name",
        "label",
        "type",
        "required"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "value": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "TEXT",
            "FILE",
            "JSON"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "required": [
        "type",
        "items"
      ],
      "additionalProperties": false
    }
  }
}
