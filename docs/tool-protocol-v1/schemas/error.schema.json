{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "工作元素 v1 error",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "nodeId": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "itemIndex": {
          "type": "integer",
          "minimum": 0
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "runId",
    "nodeId",
    "error"
  ],
  "additionalProperties": false
}
