{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "工作元素 v1 descriptor",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,99}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/port"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/port"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/parameter"
      }
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "name",
    "version",
    "description",
    "inputs",
    "outputs",
    "parameters"
  ],
  "additionalProperties": false
}
